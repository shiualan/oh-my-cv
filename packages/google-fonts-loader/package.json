{
  "name": "@ohmycv/google-fonts-loader",
  "version": "0.1.1",
  "description": "Load Goolge Fonts with ease.",
  "keywords": [
    "google fonts",
    "fonts"
  ],
  "homepage": "https://github.com/shiualan/oh-my-cv/tree/main/packages/google-fonts-loader",
  "bugs": {
    "url": "https://github.com/shiualan/oh-my-cv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiualan/oh-my-cv.git",
    "directory": "packages/google-fonts-loader"
  },
  "license": "MIT",
  "author": "Renovamen <renovamenzxh@gmail.com>",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build-fast:pkg": "tsup src/index.ts --format cjs,esm",
    "build:pkg": "pnpm run build-fast:pkg --dts"
  },
  "publishConfig": {
    "access": "public"
  }
}
