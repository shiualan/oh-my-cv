{
  "name": "@ohmycv/front-matter",
  "version": "0.1.1",
  "description": "A better `js-yaml`, for extracting and parsing YAML front matter from strings.",
  "keywords": [
    "yaml",
    "front matter",
    "meta data"
  ],
  "homepage": "https://github.com/shiualan/oh-my-cv/tree/main/packages/front-matter",
  "bugs": {
    "url": "https://github.com/shiualan/oh-my-cv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiualan/oh-my-cv.git",
    "directory": "packages/front-matter"
  },
  "license": "MIT",
  "author": "Renovamen <renovamenzxh@gmail.com>",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build-fast:pkg": "tsup src/index.ts --format cjs,esm",
    "build:pkg": "pnpm run build-fast:pkg --dts"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
